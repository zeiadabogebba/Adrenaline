<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title><%= t('titles.myBookings') %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">

    <link rel="stylesheet" href="/css/global.css?v=20260915i18n">
    <link rel="stylesheet" href="/css/myBookings.css?v=20260908p">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="<%= i18nScript %>"></script>
</head>
<body>

    <div class="dashboard-shell">
        <aside class="dashboard-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/" class="wordmark" style="font-size:1.25rem" aria-label="<%= t('nav.homeAria') %>"><svg class="wordmark__mark" viewBox="0 0 64 56" aria-hidden="true" focusable="false"><path class="wordmark__ridge" d="M4 51 L25 7 L37 30 L45 18.5 L60 51"/><path class="wordmark__pulse" d="M9 40 H17.5 L20.5 33.5 L23.5 45 L27 21.5 L30.5 48.5 L33.5 37 L36.5 40 H55"/></svg><span class="wordmark__text"><em>A</em>DREN<em>A</em>LINE</span></a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupTrips') %></span>
                    <ul>
                        <li><a href="/"><i class="fas fa-home"></i> <%= t('nav.home') %></a></li>
                        <li><a href="/packages/day"><i class="fas fa-sun"></i> <%= t('nav.tal3a') %></a></li>
                        <li><a href="/packages/week"><i class="fas fa-calendar-week"></i> <%= t('nav.rehla') %></a></li>
                        <li><a href="/packages/single"><i class="fas fa-location-dot"></i> <%= t('nav.pump') %></a></li>
                        <li><a href="/trips/upcoming"><i class="fas fa-rocket"></i> <%= t('nav.upcomingTrips') %></a></li>
                        <li><a href="/custom-trip"><i class="fas fa-compass"></i> <%= t('nav.requestYourOwn') %></a></li>
                        <li><a href="/trips/past"><i class="fas fa-images"></i> <%= t('nav.gallery') %></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupAccount') %></span>
                    <ul>
                        <li><a href="/dashboard"><i class="fas fa-columns"></i> <%= t('nav.dashboard') %></a></li>
                        <li class="active"><a href="/my-bookings"><i class="fas fa-suitcase-rolling"></i> <%= t('nav.myBookings') %></a></li>
                        <li><a href="/profile"><i class="fas fa-user-circle"></i> <%= t('nav.profile') %></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupSupport') %></span>
                    <ul>
                        <li><a href="/faq"><i class="fas fa-question-circle"></i> <%= t('nav.faq') %></a></li>
                        <li><a href="/contact"><i class="fas fa-envelope"></i> <%= t('nav.contact') %></a></li>
                        <li><a href="/reviews/write"><i class="fas fa-star"></i> <%= t('nav.writeReview') %></a></li>
                    </ul>
                </div>
            </nav>

            <div class="sidebar-footer">
                <button id="theme-toggle" class="theme-toggle-btn">
                    <i class="fas fa-moon"></i> <span><%= t('nav.darkMode') %></span>
                </button>
                <a href="<%= langSwitchHref %>" class="theme-toggle-btn lang-toggle-btn" hreflang="<%= otherLang %>" aria-label="<%= t('nav.langAria') %>"><i class="fas fa-language" aria-hidden="true"></i> <span><%= t('nav.langLong') %></span></a>
                <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> <%= t('nav.logout') %></a>
            </div>
        </aside>

        <main class="dashboard-main">

            <div class="page-title reveal-up">
                <h1><%- t('myBookings.heroHtml') %></h1>
                <p><%= t('myBookings.desc') %></p>
                <div class="account-chip" style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                    <div class="account-chip__avatar">
                        <% if (user.image) { %>
                        <img src="<%= user.image %>" alt="<%= user.name %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">
                        <% } else { %>
                        <i class="fas fa-user"></i>
                        <% } %>
                    </div>
                    <div>
                        <span class="account-chip__label"><%= t('nav.signedInAs') %></span>
                        <strong class="account-chip__name"><%= user.name %></strong>
                    </div>
                </div>
            </div>

            <div class="main-container">

                <aside class="filters-sidebar glass-card reveal-up">
                    <h3><%= t('myBookings.filters') %></h3>

                    <div class="filter-group">
                        <label><%= t('myBookings.status') %></label>
                        <select id="statusFilter">
                            <option value="all"><%= t('myBookings.allStatuses') %></option>
                            <% ['verifying', 'half-paid', 'fully-paid', 'cancelled', 'request-new', 'request-contacted', 'request-closed', 'request-cancelled'].forEach(s => { %><option value="<%= s %>"><%= t('js.bookings.status.' + s) %></option><% }) %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label><%= t('myBookings.tripType') %></label>
                        <select id="typeFilter">
                            <option value="all"><%= t('myBookings.allTypes') %></option>
                            <% ['day', 'week', 'single', 'custom', 'request'].forEach(ty => { %><option value="<%= ty %>"><%= t('js.bookings.filterTypes.' + ty) %></option><% }) %>
                        </select>
                    </div>
                </aside>

                <section class="bookings-container reveal-up">
                    <div id="bookingsList">
                        <% if (bookings.length === 0) { %>
                        <div style="text-align:center;padding:4rem;color:var(--color-text-muted);">
                            <i class="fas fa-suitcase-rolling" style="font-size:4rem;color:var(--crimson);margin-bottom:1rem;display:block;"></i>
                            <h3><%= t('myBookings.noTripsYet') %></h3>
                            <p><%= t('myBookings.noTripsYetDesc') %></p>
                            <a href="/packages/day" class="btn btn--primary" style="display:inline-block;margin-top:1rem;"><%= t('myBookings.browsePackages') %></a>
                        </div>
                        <% } else { %>
                        <% bookings.forEach(booking => { %>
                        <% const bookingImage = (booking.tripId && booking.tripId.image) || (booking.packageId && booking.packageId.image) || ''; %>
                        <% const slug = booking.computedStatus.replace(/\s+/g, '-'); %>
                        <div class="booking-card reveal-up" data-status="<%= slug %>" data-type="<%= booking.tripId ? 'trip' : (booking.packageId ? booking.packageId.type : 'day') %>">
                            <div class="booking-card__image">
                                <% if (bookingImage) { %>
                                <img src="<%= bookingImage %>" alt="<%= booking.packageName %>">
                                <% } else { %>
                                <i class="fas fa-landmark"></i>
                                <% } %>
                            </div>
                            <div class="booking-card__info">
                                <div class="booking-card__header">
                                    <h3><%= booking.packageName %></h3>
                                    <span class="status-badge status-<%= slug %>">
                                        <%= t('js.bookings.status.' + slug) %>
                                    </span>
                                </div>
                                <p><i class="fas fa-hashtag" style="color:var(--crimson);"></i> <%= booking.bookingNumber %></p>
                                <p><i class="fas fa-calendar" style="color:var(--crimson);"></i> <%= booking.date || new Date(booking.createdAt).toLocaleDateString(lang === 'ar' ? 'ar-EG-u-nu-latn' : 'en-US') %></p>
                                <p><i class="fas fa-users" style="color:var(--crimson);"></i> <%= tp('js.bookings.travellersCount', booking.travelers) %> &middot; <strong class="text-gold"><%= money(booking.totalPrice) %></strong></p>
                            </div>
                            <div class="booking-card__actions">
                                <a href="/booking/<%= booking._id %>" class="btn btn--primary btn--small"><%= t('myBookings.viewDetails') %></a>
                                <% if (booking.computedStatus !== 'cancelled') { %>
                                <button class="btn btn--outline btn--small cancel-btn" data-id="<%= booking._id %>" style="color:var(--color-danger);border-color:var(--color-danger);"><%= t('myBookings.cancel') %></button>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>
                        <% } %>
                    </div>
                </section>
            </div>

            <div id="detailsModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2><%= t('myBookings.modalTitle') %></h2>
                        <span class="close-modal">&times;</span>
                    </div>
                    <div id="modalBody"></div>
                </div>
            </div>

            <footer class="main-footer reveal-up">
                <div class="container footer-grid">
                    <div class="footer-brand">
                        <a href="/" class="wordmark footer-logo" style="font-size:1.4rem" aria-label="<%= t('nav.homeAria') %>"><svg class="wordmark__mark" viewBox="0 0 64 56" aria-hidden="true" focusable="false"><path class="wordmark__ridge" d="M4 51 L25 7 L37 30 L45 18.5 L60 51"/><path class="wordmark__pulse" d="M9 40 H17.5 L20.5 33.5 L23.5 45 L27 21.5 L30.5 48.5 L33.5 37 L36.5 40 H55"/></svg><span class="wordmark__text"><em>A</em>DREN<em>A</em>LINE</span></a>
                        <p class="brand-tagline"><%- t('footer.taglineHtml') %></p>
                    </div>
                    <nav class="footer-nav" aria-label="<%= t('footer.navAria') %>">
                        <div class="footer-group">
                            <h4><%= t('footer.explore') %></h4>
                            <ul>
                                <li><a href="/packages/day"><%= t('nav.tal3a') %></a></li>
                                <li><a href="/packages/week"><%= t('nav.rehla') %></a></li>
                                <li><a href="/packages/single"><%= t('nav.pump') %></a></li>
                                <li><a href="/custom-trip"><%= t('nav.requestYourOwn') %></a></li>
                            </ul>
                        </div>
                        <div class="footer-group">
                            <h4><%= t('footer.operations') %></h4>
                            <ul>
                                <li><a href="/about"><%= t('nav.about') %></a></li>
                                <li><a href="/faq"><%= t('nav.faq') %></a></li>
                            </ul>
                        </div>
                        <div class="footer-group">
                            <h4><%= t('footer.dispatch') %></h4>
                            <ul>
                                <li><a href="/contact"><%= t('nav.contact') %></a></li>
                                <li><a href="/reviews/write"><%= t('nav.writeReview') %></a></li>
                            </ul>
                        </div>
                    </nav>
                </div>
                <div class="footer-bottom container">
                    <p>&copy; <%= new Date().getFullYear() %> <%= t('footer.rights') %></p>
                    <div class="footer-social"><a href="https://www.instagram.com/98adrenaline98" target="_blank" rel="noopener" aria-label="<%= t('footer.instagramAria') %>"><i class="fab fa-instagram"></i></a><a href="https://www.tiktok.com/@adrenaline985?_r=1" target="_blank" rel="noopener" aria-label="<%= t('footer.tiktokAria') %>"><i class="fab fa-tiktok"></i></a><a href="https://chat.whatsapp.com/Er5z0p7Hrsf6l1394EycnO?mode=gi_t" target="_blank" rel="noopener" aria-label="<%= t('footer.whatsappAria') %>"><i class="fab fa-whatsapp"></i></a></div>
                </div>
            </footer>

        </main>
    </div>

    <script>
        const SERVER_DATA = {
            user: <%- JSON.stringify(user) %>,
            bookings: <%- JSON.stringify(bookings) %>,
            tripRequests: <%- JSON.stringify(tripRequests) %>
        };
        window.SERVER_USER = SERVER_DATA.user;
        window.SERVER_BOOKINGS = SERVER_DATA.bookings;
        window.SERVER_TRIP_REQUESTS = SERVER_DATA.tripRequests;

        document.querySelectorAll('.cancel-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                if (!confirm(window.t('js.bookings.confirmCancelSimple'))) return;
                try {
                    const res = await fetch('/api/bookings/' + id + '/cancel', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: 'Cancelled by user' })
                    });
                    if (res.ok) { window.location.reload(); }
                    else { const d = await res.json(); alert(d.message || window.t('js.bookings.cancellationFailed')); }
                } catch (err) { alert(window.t('js.bookings.errorTryAgain')); }
            });
        });

        function applyFilters() {
            const status = document.getElementById('statusFilter').value;
            const type = document.getElementById('typeFilter').value;
            document.querySelectorAll('.booking-card').forEach(card => {
                const matchStatus = status === 'all' || card.dataset.status === status;
                const matchType = type === 'all' || card.dataset.type === type;
                card.style.display = matchStatus && matchType ? '' : 'none';
            });
        }
        document.getElementById('statusFilter').addEventListener('change', applyFilters);
        document.getElementById('typeFilter').addEventListener('change', applyFilters);

</script>
    <script src="/js/global.js"></script>
    <script src="/js/myBookings.js"></script>
</body>
</html>
