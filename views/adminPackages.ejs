<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title>Catalogue Management | Adrenaline</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/global.css?v=20260915i18n">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/adminPackages.css?v=20260915a">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Adrenaline Ops</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <i id="theme-icon-sun" class="fas fa-sun" aria-hidden="true"></i>
                <i id="theme-icon-moon" class="fas fa-moon" aria-hidden="true" style="display:none"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li class="active"><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Catalogue Management</a></li>
                <li><a href="/admin/trips"><i class="fas fa-rocket"></i> Trip Management</a></li>
                <li><a href="/admin/trip-requests"><i class="fas fa-compass"></i> Trip Requests</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--crimson);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="top-bar-left">
                <h1>Catalogue Inventory</h1>
                <p>Manage and organize tours, day trips, and premium week packages</p>
            </div>
            <div class="top-bar-right">
                <button class="btn-primary" id="createPackageBtn"><i class="fas fa-plus"></i> Create New Package</button>
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-boxes-packing"></i></div>
                <div class="stat-info">
                    <h3>Total Packages</h3>
                    <div class="stat-value" id="totalPackages">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--color-success)"><i class="fas fa-check-circle"></i></div>
                <div class="stat-info">
                    <h3>Active Packages</h3>
                    <div class="stat-value" id="activePackages">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--crimson)"><i class="fas fa-star"></i></div>
                <div class="stat-info">
                    <h3>Most Popular</h3>
                    <div class="stat-value" id="mostPopular">--</div>
                </div>
            </div>
        </section>

        <div class="toolbar">
            <div class="toolbar-left">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search by name or location...">
                </div>
                <select id="typeFilter" class="select-modern">
                    <option value="all">All Types</option>
                    <option value="single">Pump ur Adrenaline</option>
                    <option value="day">Tal3a Packages</option>
                    <option value="week">Rehla Packages</option>
                </select>
                <select id="statusFilter" class="select-modern">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
        </div>

        <nav class="tab-navigation">
            <button class="tab-link active" data-type="all">All Inventory</button>
            <button class="tab-link" data-type="single">Pump ur Adrenaline</button>
            <button class="tab-link" data-type="day">Tal3a Packages</button>
            <button class="tab-link" data-type="week">Rehla Packages</button>
        </nav>

        <section class="packages-grid" id="packagesContainer"></section>
    </main>
</div>

<div class="modal-overlay" id="selectTypeModal">
    <div class="modal-container" style="max-width:550px;">
        <div class="modal-header">
            <h3>Select Package Type</h3>
            <button class="modal-close" onclick="closeModal('selectTypeModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="type-options-container">
                <button class="type-btn" data-type="single"><i class="fas fa-map-marker-alt"></i><span>Pump ur Adrenaline</span></button>
                <button class="type-btn" data-type="day"><i class="fas fa-sun"></i><span>Tal3a Packages</span></button>
                <button class="type-btn" data-type="week"><i class="fas fa-calendar-week"></i><span>Rehla Packages</span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="packageModal">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="modalTitle">Create Package</h3>
            <button class="modal-close" onclick="closeModal('packageModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="packageForm" class="form-grid">
                <input type="hidden" id="packageId">

                <div class="form-group full-width">
                    <label>Photo</label>
                    <div id="imagePreviewArea" onclick="document.getElementById('pkgImageFile').click()" style="width:100%;height:160px;border:2px dashed var(--color-border);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--color-surface-alt);cursor:pointer;margin-bottom:8px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--crimson)'" onmouseout="this.style.borderColor='var(--color-border)'">
                        <img id="imagePreview" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Selected package image preview" style="display:none;width:100%;height:100%;object-fit:cover;">
                        <div id="imageUploadPlaceholder" style="text-align:center;color:var(--color-text-muted);pointer-events:none;">
                            <i class="fas fa-image" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
                            <span style="font-size:0.85rem;">Click to choose image</span>
                        </div>
                    </div>
                    <input type="file" id="pkgImageFile" accept="image/jpeg,image/png,image/webp" style="display:none;">
                </div>

                <div class="form-group full-width">
                    <label>Name *</label>
                    <input type="text" id="pkgName" required placeholder="e.g., Luxor & the West Bank">
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <input type="text" id="pkgType" readonly disabled style="background:var(--surface);color:var(--crimson);font-weight:700;">
                </div>
                <div class="form-group">
                    <label>Visibility</label>
                    <select id="pkgStatus">
                        <option value="active">Shown on the site</option>
                        <option value="inactive">Hidden</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label>Description</label>
                    <textarea id="pkgDescription" rows="3" placeholder="A short line or two about this offering."></textarea>
                </div>

                <div class="form-group full-width">
                    <fieldset class="ar-fieldset">
                        <legend>Arabic version <span style="font-weight:400;text-transform:none;color:var(--color-text-muted);">(optional)</span></legend>
                        <p style="font-size:0.78rem;color:var(--color-text-muted);margin:0 0 8px;">Shown when a visitor switches the site to Arabic. Leave a field blank to show the English text instead.</p>
                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label>Name (Arabic)</label>
                                <input type="text" id="arPkgName" dir="rtl" lang="ar">
                            </div>
                            <div class="form-group full-width">
                                <label>Description (Arabic)</label>
                                <textarea id="arPkgDescription" rows="3" dir="rtl" lang="ar"></textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <p class="form-group full-width" style="font-size:0.8rem;color:var(--color-text-muted);margin:0;">
                    <i class="fas fa-circle-info"></i> Catalog cards show the photo, name and description only. Dates, pricing, capacity and the day-by-day itinerary live on <a href="/admin/trips" style="color:var(--crimson);">Trip Management</a>.
                </p>

                <div class="form-group full-width" id="formError" style="display:none;">
                    <p style="color:var(--color-danger);font-weight:600;" id="formErrorMsg"></p>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-ghost" onclick="closeModal('packageModal')">Cancel</button>
            <button class="btn-primary" id="savePackageBtn">Save Changes</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteModal">
    <div class="modal-container" style="max-width:400px;text-align:center;">
        <div class="modal-header">
            <h3>Confirm Delete</h3>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to remove <strong id="deletePackageName" style="color:var(--color-danger)"></strong>?</p>
            <p style="font-size:0.8rem;color:var(--color-text-muted);margin-top:10px;">This action cannot be undone and will remove all related booking availability.</p>
        </div>
        <div class="modal-footer" style="justify-content:center;">
            <button class="btn-ghost" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-primary" style="background:var(--color-danger)" id="confirmDeleteBtn">Delete Forever</button>
        </div>
    </div>
</div>

<script>
    const SERVER_DATA = {
        user: <%- JSON.stringify(user) %>,
        packages: <%- JSON.stringify(packages.map(p => ({
            id: String(p._id),
            _id: String(p._id),
            type: p.type,
            name: p.name,
            city: p.city || '',
            description: p.description || '',
            image: p.image || '',
            price: p.price || 0,
            status: p.status || 'active',
            rating: p.rating || 4.5,
            reviews: p.reviewCount || 0,

            minGroup: p.minGroup || 1,
            maxGroup: p.maxGroup || 15,
            includedServices: p.includedServices || '',
            openingHours: p.openingHours || '',
            closingDays: p.closingDays || '',
            recommendedDuration: p.recommendedDuration || '',
            guidedTour: p.guidedTour || 'yes',
            duration: p.duration || '',
            itinerary: p.itinerary || [],
            durationDays: p.durationDays || '',
            nights: p.nights || '',
            accommodationIncluded: p.accommodationIncluded || 'yes',
            hotelName: p.hotelName || '',
            dailyItinerary: p.dailyItinerary || [],
            ar: { name: (p.ar && p.ar.name) || '', description: (p.ar && p.ar.description) || '' },
        }))) %>
    };
    window.SERVER_DATA = SERVER_DATA;
    window.SERVER_USER = SERVER_DATA.user;

</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
<script src="/js/adminPackages.js"></script>
</body>
</html>
