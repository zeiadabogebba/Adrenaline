<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title><%= preset ? preset.name : 'New preset' %> | Treasure Hunt</title>
    <link rel="icon" href="/images/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <link rel="icon" href="/images/favicon-96.png?v=2" type="image/png" sizes="96x96">
    <link rel="icon" href="/images/favicon-192.png?v=2" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2">
    <link rel="stylesheet" href="/css/global.css?v=20261002b">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/adminPackages.css?v=20261119a">
    <link rel="stylesheet" href="/css/adminPhotoBooks.css?v=20261126b">
    <link rel="stylesheet" href="/css/adminTreasureHunt.css?v=20261128d">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Adrenaline Ops</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <i id="theme-icon-sun" class="fas fa-sun" aria-hidden="true"></i>
                <i id="theme-icon-moon" class="fas fa-moon" aria-hidden="true" style="display:none"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Catalogue Management</a></li>
                <li><a href="/admin/trips"><i class="fas fa-rocket"></i> Trip Management</a></li>
                <li><a href="/admin/photo-books"><i class="fas fa-book-open"></i> Photo Books</a></li>
                <li class="active"><a href="/admin/treasure-hunt"><i class="fas fa-map-location-dot"></i> Treasure Hunt</a></li>
                <li><a href="/admin/trip-requests"><i class="fas fa-compass"></i> Trip Requests</a></li>
                <li><a href="/admin/emails"><i class="fas fa-envelope-open-text"></i> Email Campaigns</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
                <li class="sidebar-site-link"><a href="/"><i class="fas fa-arrow-left"></i> Back to Site</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--crimson);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="top-bar-left">
                <a class="pbx-back" href="/admin/treasure-hunt"><i class="fas fa-arrow-left" aria-hidden="true"></i> Treasure Hunt</a>
                <h1 id="thePresetTitle"><%= preset ? preset.name : 'New preset' %></h1>
                <p>Each route is a list of stops, and every route ends at the shared finish. A clue can be a riddle, a photo, or both. In a QR hunt a team sees the clue for a stop once it clears the stop before it; in a selfie hunt it sees every clue at once.</p>
            </div>
        </header>

        <% if (locked) { %>
        <p class="thx-hint thx-hint--warn"><i class="fas fa-lock"></i> Teams have already played this preset, so routes and stops can't be added, removed or reordered. You can still edit the text, photos and codes. Duplicate the preset to change its routes.</p>
        <% } %>

        <div id="thxEditor" class="thx-editor"></div>

        <div class="thx-savebar">
            <% if (preset) { %><a class="thx-btn" id="thxPrint" href="/admin/treasure-hunt/presets/<%= preset._id %>/print" target="_blank" rel="noopener"><i class="fas fa-print"></i> Print QR codes</a><% } %>
            <span class="thx-savebar__state" id="thxDirty"></span>
            <button type="button" class="thx-btn thx-btn--primary" id="thxSave"><i class="fas fa-floppy-disk"></i> Save preset</button>
        </div>
        <div class="pbx-toast" id="thxToast" role="status" hidden></div>
    </main>
</div>

<script>
    window.SERVER_USER = <%- JSON.stringify(user).replace(/</g, '\\u003c') %>;
    window.HUNT_PRESET = <%- JSON.stringify(preset).replace(/</g, '\\u003c') %>;
    window.HUNT_LOCKED = <%= locked ? 'true' : 'false' %>;
</script>
<script src="/js/adminHuntPreset.js?v=20261128d"></script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
</body>
</html>
