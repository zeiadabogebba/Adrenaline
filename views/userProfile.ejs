<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title><%= t('titles.userProfile') %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">

    <link rel="stylesheet" href="/css/global.css?v=20260915i18n">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/userProfile.css?v=20260915i18n">
    <script src="<%= i18nScript %>"></script>
</head>

<body>
    <div id="alertContainer" class="hidden"></div>

    <div class="dashboard-shell">

        <aside class="dashboard-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/" class="wordmark" style="font-size:1.25rem" aria-label="<%= t('nav.homeAria') %>"><svg class="wordmark__mark" viewBox="0 0 64 56" aria-hidden="true" focusable="false"><path class="wordmark__ridge" d="M4 51 L25 7 L37 30 L45 18.5 L60 51"/><path class="wordmark__pulse" d="M9 40 H17.5 L20.5 33.5 L23.5 45 L27 21.5 L30.5 48.5 L33.5 37 L36.5 40 H55"/></svg><span class="wordmark__text"><em>A</em>DREN<em>A</em>LINE</span></a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupTrips') %></span>
                    <ul>
                        <li><a href="/"><i class="fas fa-home"></i> <%= t('nav.home') %></a></li>
                        <li><a href="/packages/day"><i class="fas fa-sun"></i> <%= t('nav.tal3a') %></a></li>
                        <li><a href="/packages/week"><i class="fas fa-calendar-week"></i> <%= t('nav.rehla') %></a></li>
                        <li><a href="/packages/single"><i class="fas fa-location-dot"></i> <%= t('nav.pump') %></a></li>
                        <li><a href="/trips/upcoming"><i class="fas fa-rocket"></i> <%= t('nav.upcomingTrips') %></a></li>
                        <li><a href="/custom-trip"><i class="fas fa-compass"></i> <%= t('nav.requestYourOwn') %></a></li>
                        <li><a href="/trips/past"><i class="fas fa-images"></i> <%= t('nav.gallery') %></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupAccount') %></span>
                    <ul>
                        <li><a href="/dashboard"><i class="fas fa-columns"></i> <%= t('nav.dashboard') %></a></li>
                        <li><a href="/my-bookings"><i class="fas fa-suitcase-rolling"></i> <%= t('nav.myBookings') %></a></li>
                        <li class="active"><a href="/profile"><i class="fas fa-user-circle"></i> <%= t('nav.profile') %></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label"><%= t('nav.groupSupport') %></span>
                    <ul>
                        <li><a href="/faq"><i class="fas fa-question-circle"></i> <%= t('nav.faq') %></a></li>
                        <li><a href="/contact"><i class="fas fa-envelope"></i> <%= t('nav.contact') %></a></li>
                        <li><a href="/reviews/write"><i class="fas fa-star"></i> <%= t('nav.writeReview') %></a></li>
                    </ul>
                </div>
            </nav>

            <div class="sidebar-footer">
                <button id="theme-toggle" class="theme-toggle-btn">
                    <i class="fas fa-moon"></i> <span><%= t('nav.darkMode') %></span>
                </button>
                <a href="<%= langSwitchHref %>" class="theme-toggle-btn lang-toggle-btn" hreflang="<%= otherLang %>" aria-label="<%= t('nav.langAria') %>"><i class="fas fa-language" aria-hidden="true"></i> <span><%= t('nav.langLong') %></span></a>
                <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> <%= t('nav.logout') %></a>
            </div>
        </aside>

        <main class="dashboard-main">
            <header class="profile-header reveal-up" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
                <div>
                    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem;">
                        <h1><%= t('nav.profile') %></h1>
                    </div>
                    <p class="text-secondary"><%= t('profile.subtitle') %></p>
                </div>
            </header>

            <div class="profile-grid">

                <div class="profile-workspace-pane reveal-up">
                    <nav class="tab-nav">
                        <button class="tab-btn active" data-tab="personal"><%= t('profile.personalInfo') %></button>
                        <button class="tab-btn" data-tab="security"><%= t('profile.security') %></button>
                    </nav>

                    <section class="glass-card workspace-card tab-panel" id="tab-personal">
                        <div class="section-title-row">
                            <h2><%= t('profile.identityDetails') %></h2>
                            <div class="action-buttons">
                                <button id="editPersonalBtn" class="btn btn--outline btn--small"><i class="fa-solid fa-pen"></i> <%= t('profile.edit') %></button>
                                <button id="savePersonalBtn" class="btn btn--primary btn--small hidden"><i class="fa-solid fa-check"></i> <%= t('profile.save') %></button>
                                <button id="cancelPersonalBtn" class="btn btn--outline btn--small hidden"><i class="fa-solid fa-xmark"></i> <%= t('profile.cancel') %></button>
                            </div>
                        </div>

                        <div style="display:flex;gap:2rem;align-items:start;margin-bottom:2rem;flex-wrap:wrap;">
                            <div id="profileAvatarWrap" style="position:relative;width:100px;height:100px;display:flex;align-items:center;justify-content:center;border:2px solid var(--crimson);border-radius:50%;background:rgba(220, 38, 38, 0.1);overflow:hidden;">
                                <img id="profileAvatarImg" src="<%= user.image || '' %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;<%= user.image ? '' : 'display:none;' %>">
                                <i id="profileAvatarIcon" class="fas fa-user-circle" style="font-size:5rem;color:var(--crimson);<%= user.image ? 'display:none;' : '' %>"></i>
                            </div>
                            <div style="flex:1;min-width:200px;">
                                <h3 id="userNameDisplay" style="margin-bottom:0.5rem;"><%= user.name %></h3>
                                <p id="userEmailDisplay" class="text-secondary" style="font-size:var(--text-sm);margin-bottom:1rem;"><%= user.email %></p>
                                <input type="file" id="profilePhotoInput" class="hidden" accept="image/*">
                                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                                    <button type="button" id="uploadPhotoBtn" class="btn btn--outline btn--small">
                                        <i class="fa-solid fa-camera"></i> <%= t('profile.uploadPhoto') %>
                                    </button>
                                    <button type="button" id="removePhotoBtn" class="btn btn--outline btn--small <%= user.image ? '' : 'hidden' %>" style="color:var(--color-danger);border-color:var(--color-danger);">
                                        <i class="fa-solid fa-trash"></i> <%= t('profile.removePhoto') %>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <form id="personalInfoForm" novalidate>
                            <label><%= t('profile.fullName') %>
                                <input type="text" id="fullName" value="<%= user.name %>" disabled required minlength="2">
                                <small class="error-msg"></small>
                            </label>
                            <label><%= t('profile.email') %>
                                <input type="email" dir="ltr" id="email" value="<%= user.email %>" disabled required>
                                <small class="error-msg"></small>
                            </label>
                            <label><%= t('profile.contactNumber') %>
                                <input type="tel" dir="ltr" id="phoneNumber" value="<%= user.phone || '' %>" disabled>
                                <small class="error-msg"></small>
                            </label>
                            <label><%= t('profile.dob') %>
                                <input type="date" id="dob" value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" disabled>
                                <small class="error-msg"></small>
                            </label>
                            <label><%= t('profile.nationality') %>
                                <select id="nationality" disabled>
                                    <option value=""><%= t('profile.selectNationality') %></option>
                                    <% const countryNames = tRaw('countries.names') || {}; const aliases = { 'United Kingdom': 'UK', 'United States': 'USA' }; %>
                                    <% ["Afghanistan","Albania","Algeria","Argentina","Australia","Austria","Bangladesh","Belgium","Brazil","Canada","China","Denmark","Egypt","Finland","France","Germany","Greece","India","Indonesia","Iran","Iraq","Ireland","Italy","Japan","Jordan","Kenya","Kuwait","Lebanon","Malaysia","Mexico","Morocco","Netherlands","Nigeria","Norway","Pakistan","Philippines","Poland","Portugal","Qatar","Russia","Saudi Arabia","Singapore","South Africa","South Korea","Spain","Sweden","Switzerland","Thailand","Tunisia","Turkey","UAE","United Kingdom","United States","Vietnam","Yemen"].forEach(c => { %><option value="<%= c %>"><%= countryNames[c] || countryNames[aliases[c]] || c %></option><% }) %>
                                </select>
                                <small class="error-msg"></small>
                            </label>
                        </form>
                    </section>

                    <section class="glass-card workspace-card tab-panel hidden" id="tab-security">
                        <div class="section-title-row">
                            <h2><%= t('profile.securityTitle') %></h2>
                        </div>
                        <form id="securityForm" novalidate>
                            <label><%= t('profile.currentPassword') %>
                                <div class="pass-wrapper">
                                    <input type="password" id="currPassword" placeholder="<%= t('profile.currentPlaceholder') %>" required>
                                    <span class="eye-icon" onclick="toggleProfilePassword('currPassword')"><i class="fas fa-eye" id="eye-currPassword"></i></span>
                                </div>
                                <small class="error-msg"></small>
                            </label>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                                <label><%= t('profile.newPassword') %>
                                    <div class="pass-wrapper">
                                        <input type="password" id="newPassword" required minlength="6">
                                        <span class="eye-icon" onclick="toggleProfilePassword('newPassword')"><i class="fas fa-eye" id="eye-newPassword"></i></span>
                                    </div>
                                    <small class="error-msg"></small>
                                </label>
                                <label><%= t('profile.confirmPassword') %>
                                    <div class="pass-wrapper">
                                        <input type="password" id="confirmPassword" required>
                                        <span class="eye-icon" onclick="toggleProfilePassword('confirmPassword')"><i class="fas fa-eye" id="eye-confirmPassword"></i></span>
                                    </div>
                                    <small class="error-msg"></small>
                                </label>
                            </div>
                            <button type="button" id="updatePasswordBtn" class="btn btn--primary" style="margin-top:1rem;"><%= t('profile.updatePassword') %></button>
                        </form>
                        <hr style="margin:2rem 0;opacity:0.1;">
                        <div class="danger-zone">
                            <h3 style="color:var(--color-danger);font-size:var(--text-sm);margin-bottom:0.5rem;"><%= t('profile.closeAccount') %></h3>
                            <p class="text-secondary" style="font-size:var(--text-xs);margin-bottom:1rem;"><%= t('profile.closeAccountDesc') %></p>
                            <button id="deleteAccountBtn" class="btn btn--outline btn--small" style="color:var(--color-danger);border-color:var(--color-danger);"><%= t('profile.closeMyAccount') %></button>
                        </div>
                    </section>

                </div>
            </div>
        </main>
    </div>

    <div class="modal-overlay hidden" id="deleteModal">
        <div class="glass-card modal-box">
            <h3><%= t('profile.modalTitle') %></h3>
            <p class="text-secondary" style="margin-bottom:2rem;"><%= t('profile.modalDesc') %></p>
            <div style="display:flex;flex-direction:column;gap:1rem;">
                <button id="confirmDeleteBtn" class="btn btn--primary" style="background:var(--color-danger);"><%= t('profile.confirmClose') %></button>
                <button id="cancelDeleteBtn" class="btn btn--outline"><%= t('profile.neverMind') %></button>
            </div>
        </div>
    </div>

    <script>
        const SERVER_DATA = {
            user: <%- JSON.stringify(user) %>,
            bookings: <%- JSON.stringify(bookings) %>
        };
        window.SERVER_USER = SERVER_DATA.user;

        function toggleProfilePassword(id) {
            const field = document.getElementById(id);
            const icon  = document.getElementById('eye-' + id);
            if (!field || !icon) return;
            if (field.type === 'password') { field.type = 'text';     icon.className = 'fas fa-eye-slash'; }
            else                           { field.type = 'password'; icon.className = 'fas fa-eye'; }
        }

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
                btn.classList.add('active');
                document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
            });
        });

        const editBtn = document.getElementById('editPersonalBtn');
        const saveBtn = document.getElementById('savePersonalBtn');
        const cancelBtn = document.getElementById('cancelPersonalBtn');
        const formInputs = document.querySelectorAll('#personalInfoForm input:not(#email), #personalInfoForm select');

        editBtn.addEventListener('click', () => {
            formInputs.forEach(i => i.disabled = false);
            editBtn.classList.add('hidden');
            saveBtn.classList.remove('hidden');
            cancelBtn.classList.remove('hidden');
        });

        cancelBtn.addEventListener('click', () => {
            formInputs.forEach(i => i.disabled = true);
            editBtn.classList.remove('hidden');
            saveBtn.classList.add('hidden');
            cancelBtn.classList.add('hidden');
        });

        saveBtn.addEventListener('click', async () => {
            try {
                const res = await fetch('/api/users/profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: document.getElementById('fullName').value,
                        phone: document.getElementById('phoneNumber').value,
                        nationality: document.getElementById('nationality').value,
                        dob: document.getElementById('dob').value
                    })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message);
                formInputs.forEach(i => i.disabled = true);
                editBtn.classList.remove('hidden');
                saveBtn.classList.add('hidden');
                cancelBtn.classList.add('hidden');
                document.getElementById('userNameDisplay').textContent = document.getElementById('fullName').value;
            } catch (err) {
                alert(err.message || window.t('js.profile.saveFailed'));
            }
        });

        document.getElementById('deleteAccountBtn').addEventListener('click', () => {
            document.getElementById('deleteModal').classList.remove('hidden');
        });
        document.getElementById('cancelDeleteBtn').addEventListener('click', () => {
            document.getElementById('deleteModal').classList.add('hidden');
        });
        document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
            try {
                const res = await fetch('/api/users/account', { method: 'DELETE', credentials: 'include' });
                if (res.ok) {
                    window.location.href = '/';
                }
            } catch (err) { alert(window.t('js.profile.deleteFailed')); }
        });

        (function () {
            const uploadBtn = document.getElementById('uploadPhotoBtn');
            const removeBtn = document.getElementById('removePhotoBtn');
            const fileInput = document.getElementById('profilePhotoInput');
            const imgEl     = document.getElementById('profileAvatarImg');
            const iconEl    = document.getElementById('profileAvatarIcon');

            if (!uploadBtn || !fileInput) return;
            uploadBtn.dataset.photoInit = '1';

            function photoAlert(msg, type) {
                const c = document.getElementById('alertContainer');
                if (!c) return;
                c.textContent        = msg;
                c.style.background   = type === 'success' ? 'var(--crimson)' : 'var(--bad)';
                c.style.color        = '#fff';
                c.style.padding      = '12px 20px';
                c.style.borderRadius = '8px';
                c.style.position     = 'fixed';
                c.style.top          = '20px';
                c.style.insetInlineEnd = '20px';
                c.style.zIndex       = '9999';
                c.style.fontWeight   = '600';
                c.style.boxShadow    = '0 4px 20px rgba(0,0,0,0.15)';
                c.classList.remove('hidden');
                setTimeout(() => c.classList.add('hidden'), 3500);
            }

            uploadBtn.addEventListener('click', () => fileInput.click());

            fileInput.addEventListener('change', () => {
                const file = fileInput.files && fileInput.files[0];
                if (!file) return;
                if (!file.type.startsWith('image/')) {
                    photoAlert(window.t('js.profile.chooseImage'), 'error');
                    fileInput.value = '';
                    return;
                }
                if (file.size > 2 * 1024 * 1024) {
                    photoAlert(window.t('js.profile.photoTooBig'), 'error');
                    fileInput.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = e => {
                    if (imgEl) { imgEl.src = e.target.result; imgEl.style.display = 'block'; }
                    if (iconEl) iconEl.style.display = 'none';
                };
                reader.readAsDataURL(file);

                const formData = new FormData();
                formData.append('avatar', file);
                fetch('/api/users/avatar', { method: 'PUT', credentials: 'include', body: formData })
                    .then(r => r.json())
                    .then(data => {
                        if (data.status === 'success') {
                            if (imgEl) { imgEl.src = data.data.imageUrl; imgEl.style.display = 'block'; }
                            if (iconEl) iconEl.style.display = 'none';
                            if (removeBtn) removeBtn.classList.remove('hidden');
                            photoAlert(window.t('js.profile.photoUpdated'), 'success');
                        } else {
                            photoAlert(data.message || window.t('js.profile.uploadFailed'), 'error');
                        }
                    })
                    .catch(() => photoAlert(window.t('js.profile.uploadFailed'), 'error'));

                fileInput.value = '';
            });

            if (removeBtn) {
                removeBtn.addEventListener('click', async () => {
                    if (!confirm(window.t('js.profile.removeConfirm'))) return;
                    try {
                        const res = await fetch('/api/users/avatar', { method: 'DELETE', credentials: 'include' });
                        if (!res.ok) throw new Error();
                        if (imgEl) { imgEl.src = ''; imgEl.style.display = 'none'; }
                        if (iconEl) iconEl.style.display = 'block';
                        removeBtn.classList.add('hidden');
                        photoAlert(window.t('js.profile.photoRemoved'), 'success');
                    } catch {
                        photoAlert(window.t('js.profile.removeFailed'), 'error');
                    }
                });
            }
        }());

</script>
    <script src="/js/global.js"></script>
    <script src="/js/userProfile.js"></script>
</body>

</html>
