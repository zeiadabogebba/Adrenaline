<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title><%= trip.title %> results | Treasure Hunt</title>
    <link rel="icon" href="/images/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <link rel="icon" href="/images/favicon-96.png?v=2" type="image/png" sizes="96x96">
    <link rel="icon" href="/images/favicon-192.png?v=2" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2">
    <link rel="stylesheet" href="/css/global.css?v=20261002b">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/adminPackages.css?v=20261119a">
    <link rel="stylesheet" href="/css/adminPhotoBooks.css?v=20261126b">
    <link rel="stylesheet" href="/css/adminTreasureHunt.css?v=20261128b">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Adrenaline Ops</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <i id="theme-icon-sun" class="fas fa-sun" aria-hidden="true"></i>
                <i id="theme-icon-moon" class="fas fa-moon" aria-hidden="true" style="display:none"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Catalogue Management</a></li>
                <li><a href="/admin/trips"><i class="fas fa-rocket"></i> Trip Management</a></li>
                <li><a href="/admin/photo-books"><i class="fas fa-book-open"></i> Photo Books</a></li>
                <li class="active"><a href="/admin/treasure-hunt"><i class="fas fa-map-location-dot"></i> Treasure Hunt</a></li>
                <li><a href="/admin/trip-requests"><i class="fas fa-compass"></i> Trip Requests</a></li>
                <li><a href="/admin/emails"><i class="fas fa-envelope-open-text"></i> Email Campaigns</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
                <li class="sidebar-site-link"><a href="/"><i class="fas fa-arrow-left"></i> Back to Site</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--crimson);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="top-bar-left">
                <a class="pbx-back" href="/admin/treasure-hunt#trips"><i class="fas fa-arrow-left" aria-hidden="true"></i> Treasure Hunt</a>
                <h1><%= trip.title %> results</h1>
                <p><%= trip.date || 'No date' %> &middot; <%= preset ? preset.name : 'No preset' %> &middot; Hunt <b><%= setting.enabled ? 'On' : 'Off' %></b> &middot; Clock <b><%= setting.open ? 'Open' : 'Closed' %></b></p>
            </div>
        </header>

        <div class="thx-toolbar">
            <% if (preset && preset.mode !== 'selfie') { %><a class="thx-btn" href="/admin/treasure-hunt/presets/<%= preset._id %>/print" target="_blank" rel="noopener"><i class="fas fa-print"></i> Print QR codes</a><% } %>
            <% if (rows.length) { %><button type="button" class="thx-btn thx-btn--danger" id="thxResetAll"><i class="fas fa-rotate-left"></i> Reset all results</button><% } %>
        </div>

        <% const selfieHunt = preset && preset.mode === 'selfie'; %>
        <% if (selfieHunt && rows.length) { const waiting = rows.reduce((n, r) => n + r.selfies.filter(x => x.status === 'pending').length, 0); %>
        <section class="thx-review" id="thxReview">
            <header class="thx-review__head">
                <h2><i class="fas fa-camera"></i> Selfies and answers <span class="thx-review__count" id="thxWaiting"><%= waiting %> to check</span></h2>
                <p>Approve a stop if the selfie shows the team there and the answer is right. Rejecting one reopens that team's clock until it sends again for that stop. New entries show when you reload.</p>
                <label class="thx-review__filter"><input type="checkbox" id="thxOnlyPending" checked> Only show stops to check</label>
            </header>
            <% rows.forEach(r => { if (!r.selfies.length) return; %>
            <article class="thx-review__team" data-review-team="<%= r._id %>" style="--route:<%= r.route.color %>">
                <h3><span class="thx-swatch"></span><b class="thx-teamid"><%= r.code.slice(0, 4) %>-<%= r.code.slice(4) %></b> <span dir="auto"><%= r.route.name %></span> <small><%= r.members.map(m => m.name).join(', ') %></small></h3>
                <div class="thx-shots">
                    <% r.selfies.forEach(x => { %>
                    <figure class="thx-shot is-<%= x.status %><%= x.complete ? '' : ' is-partial' %>" data-leg="<%= x.leg %>" data-at="<%= x.at %>">
                        <% if (x.url) { %><a href="<%= x.url %>" target="_blank" rel="noopener"><img src="<%= x.url.replace('/upload/', '/upload/c_fill,w_360,h_360,q_auto,f_auto/') %>" alt="Selfie at <%= x.label %>" loading="lazy"></a><% } else if (x.proof !== 'answer') { %><span class="thx-shot__noimg"><i class="fas fa-camera"></i> No selfie yet</span><% } %>
                        <figcaption>
                            <b><%= x.leg + 1 %>. <span dir="auto"><%= x.label %></span></b>
                            <% if (x.proof !== 'photo') { %>
                            <span class="thx-shot__answer">
                                <% if (x.answerPrompt) { %><small dir="auto"><%= x.answerPrompt %></small><% } %>
                                <span>Team: <b dir="auto"><%= x.answer || '(no answer yet)' %></b></span>
                                <% if (x.answerKey) { %><span class="thx-shot__key">Correct: <b dir="auto"><%= x.answerKey %></b></span><% } %>
                            </span>
                            <% } %>
                            <% if (!x.complete) { %><span class="thx-shot__partial">Not complete yet: the team still has to send the <%= x.url ? 'answer' : 'selfie' %>.</span><% } %>
                            <span class="thx-shot__meta"><span class="thx-ms" data-ms="<%= x.at %>"></span> &middot; <span class="thx-shot__status"><%= { pending: 'To check', approved: 'Approved', rejected: 'Rejected' }[x.status] %></span></span>
                            <span class="thx-shot__btns">
                                <button type="button" class="thx-btn thx-btn--sm thx-btn--ok" data-review="approved"><i class="fas fa-check"></i> Approve</button>
                                <button type="button" class="thx-btn thx-btn--sm thx-btn--danger" data-review="rejected"><i class="fas fa-xmark"></i> Reject</button>
                            </span>
                        </figcaption>
                    </figure>
                    <% }) %>
                </div>
            </article>
            <% }) %>
            <p class="pbx-empty" id="thxReviewEmpty" hidden>Everything is checked.</p>
        </section>
        <% } %>

        <% if (!rows.length) { %>
        <p class="pbx-empty">No team has started yet.</p>
        <% } else { %>
        <div class="thx-table-wrap">
            <table class="thx-table">
                <thead><tr><th>#</th><th>Team</th><th>Route</th><th>Members</th><th>Progress</th><th>Time</th><% if (selfieHunt) { %><th>Selfies</th><% } %><th>Lifelines</th><th>Started</th><th></th></tr></thead>
                <tbody>
                <% let rank = 0; rows.forEach(r => { if (r.elapsedMs != null) rank++; %>
                    <tr data-team="<%= r._id %>" style="--route:<%= r.route.color %>">
                        <td class="thx-rank"><%= r.elapsedMs != null ? rank : '' %></td>
                        <td><b class="thx-teamid"><%= r.code.slice(0, 4) %>-<%= r.code.slice(4) %></b></td>
                        <td><span class="thx-swatch"></span><span dir="auto"><%= r.route.name %></span></td>
                        <td class="thx-members"><%= r.members.map(m => m.name).join(', ') %></td>
                        <td><%= r.progress %> / <%= r.total %></td>
                        <td class="thx-time" data-ms="<%= r.elapsedMs == null ? '' : r.elapsedMs %>" data-start="<%= new Date(r.startedAt).getTime() %>"></td>
                        <% if (selfieHunt) { const ok = r.selfies.filter(x => x.status === 'approved').length, wait = r.selfies.filter(x => x.status === 'pending').length, no = r.selfies.filter(x => x.status === 'rejected').length; %>
                        <td class="thx-selfie-sum"><span title="Approved"><i class="fas fa-check"></i> <%= ok %></span> <span title="To check"><i class="fas fa-hourglass-half"></i> <%= wait %></span><% if (no) { %> <span title="Rejected"><i class="fas fa-xmark"></i> <%= no %></span><% } %></td>
                        <% } %>
                        <td><%= r.hintsUsed %></td>
                        <td><%= new Date(r.startedAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Cairo' }) %></td>
                        <td><button type="button" class="thx-btn thx-btn--sm thx-btn--danger" data-remove="<%= r._id %>" title="Remove this team's run">Remove</button></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>

        <% if (preset) { %>
        <details class="thx-answers"<%= selfieHunt ? ' open' : '' %>>
            <summary><i class="fas fa-key"></i> Answer sheet<%= selfieHunt ? ' (check selfies against these places)' : ' for volunteers' %></summary>
            <% preset.routes.forEach(route => { %>
            <h3 style="--route:<%= route.color %>"><span class="thx-swatch"></span><span dir="auto"><%= route.name %></span></h3>
            <ol>
                <% route.legs.forEach((l, i) => { %><li><b dir="auto"><%= l.place || 'Stop ' + (i + 1) %></b> <span dir="auto"><%= l.placement %></span><% if (l.extraHint) { %><br><small dir="auto">Extra hint: <%= l.extraHint %></small><% } %></li><% }) %>
                <li><b dir="auto"><%= preset.finish.place || 'Finish' %></b> <span dir="auto"><%= preset.finish.placement %></span></li>
            </ol>
            <% }) %>
        </details>
        <% } %>
        <div class="pbx-toast" id="thxToast" role="status" hidden></div>
    </main>
</div>

<script>
    window.SERVER_USER = <%- JSON.stringify(user).replace(/</g, '\\u003c') %>;
    (function () {
        const fmt = (ms) => { ms = Math.max(0, ms | 0); const s = Math.floor(ms / 1000); const h = Math.floor(s / 3600); const m = String(Math.floor((s % 3600) / 60)).padStart(2, '0'); const ss = String(s % 60).padStart(2, '0'); return h ? `${h}:${m}:${ss}` : `${m}:${ss}`; };
        function paint() {
            document.querySelectorAll('.thx-time').forEach(td => {
                td.textContent = td.dataset.ms ? fmt(Number(td.dataset.ms)) : fmt(Date.now() - Number(td.dataset.start)) + ' (running)';
                td.classList.toggle('is-running', !td.dataset.ms);
            });
        }
        paint(); setInterval(paint, 1000);
        document.querySelectorAll('.thx-ms[data-ms]').forEach(el => { el.textContent = fmt(Number(el.dataset.ms)); });
        const toast = document.getElementById('thxToast');
        const say = (m, bad) => { toast.textContent = m; toast.classList.toggle('is-bad', !!bad); toast.hidden = false; setTimeout(() => { toast.hidden = true; }, 4000); };
        function arm(btn, label, run) {
            btn.addEventListener('click', async () => {
                if (btn.dataset.armed !== '1') { btn.dataset.armed = '1'; const was = btn.innerHTML; btn.textContent = label; setTimeout(() => { btn.dataset.armed = ''; btn.innerHTML = was; }, 3500); return; }
                btn.disabled = true;
                try { await run(); } catch (e) { say(e.message, true); btn.disabled = false; }
            });
        }
        async function del(url) {
            const res = await fetch(url, { method: 'DELETE', credentials: 'same-origin' });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(j.message || 'Could not remove. Please try again.');
        }
        const trip = '<%= trip._id %>';
        document.querySelectorAll('[data-remove]').forEach(b => arm(b, 'Tap again', async () => { await del(`/api/admin/treasure-hunt/trips/${trip}/teams/${b.dataset.remove}`); b.closest('tr').remove(); say('Team removed. Its members can start again.'); }));
        // Selfie review
        const onlyPending = document.getElementById('thxOnlyPending');
        const LABEL = { pending: 'To check', approved: 'Approved', rejected: 'Rejected' };
        function filterShots() {
            if (!onlyPending) return;
            let visible = 0, waiting = 0;
            document.querySelectorAll('.thx-shot').forEach(f => { const pend = f.classList.contains('is-pending'); if (pend) waiting++; f.hidden = onlyPending.checked && !pend; if (!f.hidden) visible++; });
            document.querySelectorAll('[data-review-team]').forEach(t => { t.hidden = ![...t.querySelectorAll('.thx-shot')].some(f => !f.hidden); });
            document.getElementById('thxReviewEmpty').hidden = visible > 0;
            document.getElementById('thxWaiting').textContent = waiting + ' to check';
        }
        if (onlyPending) { onlyPending.addEventListener('change', filterShots); filterShots(); }
        document.querySelectorAll('[data-review]').forEach(b => b.addEventListener('click', async () => {
            const fig = b.closest('.thx-shot');
            const teamEl = b.closest('[data-review-team]');
            const status = fig.classList.contains('is-' + b.dataset.review) ? 'pending' : b.dataset.review; // tap again to undo
            fig.querySelectorAll('button').forEach(x => x.disabled = true);
            try {
                const res = await fetch(`/api/admin/treasure-hunt/trips/${trip}/teams/${teamEl.dataset.reviewTeam}/selfies/${fig.dataset.leg}`, { method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status, at: Number(fig.dataset.at) }) });
                const j = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(j.message || 'Could not save. Please try again.');
                fig.className = 'thx-shot is-' + status;
                fig.querySelector('.thx-shot__status').textContent = LABEL[status];
                say(status === 'rejected' ? 'Rejected. The team sees it and its clock is running again.' : status === 'approved' ? 'Approved.' : 'Review undone.');
                setTimeout(filterShots, 600);
            } catch (e) {
                say(e.message, true);
            } finally {
                fig.querySelectorAll('button').forEach(x => x.disabled = false);
            }
        }));

        const all = document.getElementById('thxResetAll');
        if (all) arm(all, 'Tap again to delete every team\'s run', async () => { await del(`/api/admin/treasure-hunt/trips/${trip}/teams`); location.reload(); });
    })();
</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
</body>
</html>
