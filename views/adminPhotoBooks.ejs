<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0A0A0B">
    <title>Photo Books | Adrenaline</title>
    <link rel="icon" href="/images/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <link rel="icon" href="/images/favicon-96.png?v=2" type="image/png" sizes="96x96">
    <link rel="icon" href="/images/favicon-192.png?v=2" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=2">
    <link rel="stylesheet" href="/css/global.css?v=20261002b">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/adminPackages.css?v=20261119a">
    <link rel="stylesheet" href="/css/adminPhotoBooks.css?v=20261126b">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Adrenaline Ops</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <i id="theme-icon-sun" class="fas fa-sun" aria-hidden="true"></i>
                <i id="theme-icon-moon" class="fas fa-moon" aria-hidden="true" style="display:none"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Catalogue Management</a></li>
                <li><a href="/admin/trips"><i class="fas fa-rocket"></i> Trip Management</a></li>
                <li class="active"><a href="/admin/photo-books"><i class="fas fa-book-open"></i> Photo Books</a></li>
                <li><a href="/admin/trip-requests"><i class="fas fa-compass"></i> Trip Requests</a></li>
                <li><a href="/admin/emails"><i class="fas fa-envelope-open-text"></i> Email Campaigns</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
                <li class="sidebar-site-link"><a href="/"><i class="fas fa-arrow-left"></i> Back to Site</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--crimson);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="top-bar-left">
                <h1>Electronic Photo Books</h1>
                <p>Turn a trip's photo book on so everyone booked on it sees it in their dashboard, and open or close it for new pages.</p>
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-book-open"></i></div>
                <div class="stat-info"><h3>Books On</h3><div class="stat-value" id="pbOnCount"><%= rows.filter(r => r.enabled).length %></div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--color-success)"><i class="fas fa-pen-to-square"></i></div>
                <div class="stat-info"><h3>Open for Pages</h3><div class="stat-value" id="pbOpenCount"><%= rows.filter(r => r.enabled && r.submissionsOpen).length %></div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--crimson)"><i class="fas fa-images"></i></div>
                <div class="stat-info"><h3>Pages Added</h3><div class="stat-value"><%= rows.reduce((n, r) => n + r.pages, 0) %></div></div>
            </div>
        </section>

        <% if (!rows.length) { %>
        <p class="pbx-empty">There are no trips yet. Trips appear here once they are created in Trip Management.</p>
        <% } else { %>
        <% [['upcoming', 'Upcoming trips'], ['past', 'Past trips']].forEach(([kind, label]) => { const group = rows.filter(r => r.kind === kind); if (!group.length) return; %>
        <h2 class="pbx-group"><%= label %> <span><%= group.length %></span></h2>
        <div class="pbx-list">
            <% group.forEach(r => { %>
            <article class="pbx-row <%= r.enabled ? 'is-on' : '' %>" data-trip="<%= r._id %>">
                <div class="pbx-thumb" <% if (r.image) { %>style="background-image:url('<%= r.image %>')"<% } %>></div>
                <div class="pbx-info">
                    <h3><%= r.title %><% if (r.hidden) { %> <span class="pbx-tag">Hidden on site</span><% } %></h3>
                    <p><%= r.date || 'No date' %> &middot; <%= r.travellers %> traveller<%= r.travellers === 1 ? '' : 's' %> booked &middot; <span title="Each booking's photo book belongs to the account that made it"><%= r.accounts %> booking account<%= r.accounts === 1 ? '' : 's' %> can open it</span> &middot; <span class="pbx-pages"><%= r.pages %> page<%= r.pages === 1 ? '' : 's' %> from <%= r.contributors %> traveller<%= r.contributors === 1 ? '' : 's' %></span></p>
                    <% if (r.pages) { %><a class="pbx-view" href="/admin/photo-books/<%= r._id %>"><i class="fas fa-book-open" aria-hidden="true"></i> View books</a><% } %>
                </div>
                <div class="pbx-switches">
                    <label class="pbx-switch">
                        <input type="checkbox" data-field="enabled" <%= r.enabled ? 'checked' : '' %>>
                        <span class="pbx-switch__track" aria-hidden="true"></span>
                        <span class="pbx-switch__label">Photo book <b class="pbx-state"><%= r.enabled ? 'On' : 'Off' %></b></span>
                    </label>
                    <label class="pbx-switch">
                        <input type="checkbox" data-field="submissionsOpen" <%= r.submissionsOpen ? 'checked' : '' %> <%= r.enabled ? '' : 'disabled' %>>
                        <span class="pbx-switch__track" aria-hidden="true"></span>
                        <span class="pbx-switch__label">New pages <b class="pbx-state"><%= r.submissionsOpen ? 'Open' : 'Closed' %></b></span>
                    </label>
                </div>
            </article>
            <% }) %>
        </div>
        <% }) %>
        <% } %>
        <div class="pbx-toast" id="pbxToast" role="status" hidden></div>
    </main>
</div>

<script>
    window.SERVER_USER = <%- JSON.stringify(user) %>;
    (function () {
        const toast = document.getElementById('pbxToast');
        let timer = null;
        function say(msg, bad) {
            toast.textContent = msg;
            toast.classList.toggle('is-bad', !!bad);
            toast.hidden = false;
            clearTimeout(timer);
            timer = setTimeout(() => { toast.hidden = true; }, 3500);
        }
        function counts() {
            const rows = [...document.querySelectorAll('.pbx-row')];
            document.getElementById('pbOnCount').textContent = rows.filter(r => r.querySelector('[data-field=enabled]').checked).length;
            document.getElementById('pbOpenCount').textContent = rows.filter(r => r.querySelector('[data-field=enabled]').checked && r.querySelector('[data-field=submissionsOpen]').checked).length;
        }
        function paint(row) {
            const on = row.querySelector('[data-field=enabled]');
            const open = row.querySelector('[data-field=submissionsOpen]');
            row.classList.toggle('is-on', on.checked);
            open.disabled = !on.checked;
            on.closest('.pbx-switch').querySelector('.pbx-state').textContent = on.checked ? 'On' : 'Off';
            open.closest('.pbx-switch').querySelector('.pbx-state').textContent = open.checked ? 'Open' : 'Closed';
        }
        document.querySelectorAll('.pbx-row input[type=checkbox]').forEach((box) => {
            box.addEventListener('change', async () => {
                const row = box.closest('.pbx-row');
                const title = row.querySelector('h3').firstChild.textContent.trim();
                const field = box.dataset.field;
                const value = box.checked;
                row.querySelectorAll('input').forEach(i => { i.dataset.wasDisabled = i.disabled; i.disabled = true; });
                try {
                    const res = await fetch('/api/admin/photo-books/' + row.dataset.trip, {
                        method: 'PATCH',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ [field]: value }),
                    });
                    const json = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(json.message || 'Could not save. Please try again.');
                    row.querySelector('[data-field=enabled]').checked = json.data.enabled;
                    row.querySelector('[data-field=submissionsOpen]').checked = json.data.submissionsOpen;
                    say(field === 'enabled'
                        ? `${title}: photo book ${value ? 'turned on, travellers can now see it' : 'turned off, hidden from travellers'}.`
                        : `${title}: new pages ${value ? 'open' : 'closed, travellers can still view their books'}.`);
                } catch (err) {
                    box.checked = !value;
                    say(err.message, true);
                } finally {
                    row.querySelectorAll('input').forEach(i => { i.disabled = i.dataset.wasDisabled === 'true'; });
                    paint(row);
                    counts();
                }
            });
        });
    })();
</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
</body>
</html>
